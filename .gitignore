# Python caches
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.cache/

# Virtual environments and local env files
.venv/
venv/
env/
*.env
.env*

# Logs and run outputs
logs/
*.log
*.pid
nohup.out
wandb/
runs/
outputs/
tmp/
temp/
artifacts/

# Large datasets and generated assets
dataset/
retrieval_assets/
data/
datasets/

# Model weights and checkpoints
models/
checkpoints/
checkpoint-*/
**/checkpoint-*/
adapter_model.safetensors
model.safetensors
pytorch_model.bin
trainable_model.bin
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.gguf

# Common large data formats
*.jsonl
*.jsonl.gz
*.csv
*.tsv
*.npy
*.npz
*.pkl
*.pickle
*.arrow
*.tar
*.tar.gz
*.zip
*.gz

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Keep source, docs, manifests, and small JSON configs trackable.
!MANIFEST.md
!next_plan.md
!600steps.json
!docs/
!docs/**
!src/
!src/**
!scripts/
!scripts/**
!schemas/
!schemas/**
!experiments/
!experiments/**/*.md
!experiments/**/*.py
!experiments/**/*.json
!*.md
!*.py
!*.json

# Re-apply hard ignores after allow-list rules above. Keep generated caches and
# bulky artifacts out even when their parent source/report directories are kept.
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.cache/
